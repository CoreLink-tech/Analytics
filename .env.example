# Analytics History Archive — Environment Variables
# Copy this file to .env.local and fill in real values.
# NEVER commit real secrets or .env.local to Git.

# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Authentication (Auth.js / NextAuth) — Stage 4
# Generate with: openssl rand -base64 32
AUTH_SECRET=
# Optional explicit URL for Auth.js
# AUTH_URL=http://localhost:3000

# Cloudflare D1 (database) — Stage 6+
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_D1_DATABASE_ID=
# CLOUDFLARE_API_TOKEN=

# Cloudflare R2 (file storage) — Stage 7+
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME=
# R2_PUBLIC_URL=

# Optional: AI provider (Stage 12)
# AI_API_KEY=
