# Analytics History Archive — Environment Variables
# Copy to .env.local / Vercel Project Settings. NEVER commit real secrets.

NEXT_PUBLIC_APP_URL=http://localhost:3000

# Required in production (openssl rand -base64 32)
AUTH_SECRET=

# Database — MUST be SQLite-compatible libsql/Turso (NOT Vercel Postgres / Neon)
# Local: omit DATABASE_URL → file:./data/aha.db
# Production (Vercel): required
# DATABASE_URL=libsql://YOUR-DB-NAME-ORG.turso.io
# DATABASE_AUTH_TOKEN=eyJ...
#
# Migrations auto-run when DATABASE_URL is a remote libsql URL.
# ALLOW_AUTO_MIGRATE=1

# Optional AI insights
# AI_API_KEY=
# AI_BASE_URL=https://api.x.ai/v1
# AI_MODEL=grok-3
