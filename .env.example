# Analytics History Archive — Environment Variables
# Copy to .env.local. NEVER commit real secrets.

# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Authentication (Auth.js)
# Generate: openssl rand -base64 32
AUTH_SECRET=

# Database (Stage 6)
# Local/dev: omit DATABASE_URL to use file:./data/aha.db
# Production (required): remote libsql/Turso URL
# DATABASE_URL=libsql://your-db.turso.io
# DATABASE_AUTH_TOKEN=
#
# Auto-migrate runs in development only.
# In production run: npm run db:migrate
# Optional override: ALLOW_AUTO_MIGRATE=1
#
# R2 object storage is deferred until the product is otherwise complete.

# Cloudflare D1 (optional later — same SQL dialect)
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_D1_DATABASE_ID=
# CLOUDFLARE_API_TOKEN=
