# Analytics History Archive — Environment Variables
# Copy to .env.local. NEVER commit real secrets.

# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Authentication (Auth.js)
# Generate: openssl rand -base64 32
AUTH_SECRET=

# Database (Stage 6)
# Default (local): file:./data/aha.db via libsql (no URL required)
# Remote (Turso / libsql):
# DATABASE_URL=libsql://your-db.turso.io
# DATABASE_AUTH_TOKEN=
#
# Cloudflare D1 uses the same SQL schema; wire D1 bindings when deploying
# on Cloudflare Workers (documented in docs/architecture.md).

# Cloudflare D1 (optional later)
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_D1_DATABASE_ID=
# CLOUDFLARE_API_TOKEN=

# Cloudflare R2 (Stage 7+)
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME=
